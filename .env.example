# ── Server ───────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# Public URL of THIS API (used for OAuth + payment callbacks)
SERVER_URL=https://freelancer-backend-khaki.vercel.app

# ── Frontend / CORS ──────────────────────────────────────
CLIENT_URL=https://freelancers-assistant.vercel.app
# Extra allowed origins, comma separated (custom domain, staging…)
CORS_ORIGINS=
# Allow https://freelancers-assistant-*.vercel.app preview deployments
CORS_ALLOW_VERCEL_PREVIEWS=false
VERCEL_PROJECT_SLUG=freelancers-assistant

# ── Database ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/aurelance?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OAuth (leave blank to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Aurelance <hello@yourdomain.com>"
EMAIL_FROM=Aurelance <onboarding@resend.dev>
SUPPORT_INBOX=aurelance454@gmail.com

# Optional — instant notifications and messages (pusher.com → Channels → App keys).
# Leave empty and the app polls instead.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# ── AI (Anthropic) ───────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT_FREE=15
AI_DAILY_LIMIT_PREMIUM=250

# ── Payments (Safepay) ───────────────────────────────────
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
BILLING_CURRENCY=PKR
FX_USD_PKR_FALLBACK=280

# ── Operators ────────────────────────────────────────────
ADMIN_EMAILS=

# ── Scheduled jobs ───────────────────────────────────────
# Vercel Cron sends this as a bearer token. Any long random string.
CRON_SECRET=

# ── Identity verification ───────────────────────────────
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_KEY=
